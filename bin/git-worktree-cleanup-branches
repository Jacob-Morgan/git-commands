#!/bin/sh

## Remove worktrees whose upstream (remote) branch is gone.
##
## Scans the worktrees created by `git worktree-checkout-branches` (those
## living under the worktree root) and, for each one whose branch tracks
## a remote branch that no longer exists, removes the worktree and deletes
## the now-orphaned local branch.
##
## A branch is considered "gone" when the remote no longer advertises a
## branch of the same name -- decided by asking the remote directly
## (`git ls-remote --heads`), NOT by the branch's configured upstream.
##
## The upstream is deliberately ignored because it's unreliable for this
## workflow. Worktrees made by `git worktree-checkout-branches` run
## `git worktree add -b <branch> <path> <remote>/<branch>`, which usually
## sets no upstream at all; and when `branch.autoSetupMerge` does set one,
## it can point at the BASE branch (e.g. origin/master) rather than a
## same-named remote branch. Either way `%(upstream:track)` never reports
## "[gone]" for a deleted branch, so trusting it would leave such
## worktrees behind forever. The remote branch list has no such ambiguity.
##
## The remote is queried once, up front. Stale remote-tracking refs are
## also pruned first with `git fetch --prune` so the subsequent worktree
## removal is clean (disable the network step with --no-fetch /
## $GIT_WORKTREE_NO_FETCH; the ls-remote query then determines gone-ness,
## and if the remote is unreachable every worktree is kept).
##
## Because deleting branches is destructive, this prompts for confirmation
## per branch by default. Pass -y/--yes (or set $GIT_WORKTREE_CLEANUP_YES=1)
## to delete without prompting. See the sister command
## `git worktree-prune-branches` for the non-interactive form.
##
## A worktree is also kept, regardless of prompts, when it has uncommitted
## changes (a dirty working tree or index) that would be lost by removing
## it. Pass -f/--force (or set $GIT_WORKTREE_FORCE=1) to override this
## safety check and remove such worktrees anyway.
##
## Usage: git worktree-cleanup-branches [-y|--yes] [-f|--force]
##                                      [-n|--dry-run] [--no-fetch]
##                                      [remote]
##
## Override the worktree location with $GIT_WORKTREE_ROOT.

set -e

_ASSUME_YES="${GIT_WORKTREE_CLEANUP_YES:-0}"
_FORCE="${GIT_WORKTREE_FORCE:-0}"
_DRY_RUN=0
_FETCH=1
[ -n "${GIT_WORKTREE_NO_FETCH}" ] && _FETCH=0
_REMOTE=""

# Parse options. Positional arg (if any) is the remote name.
while [ "$#" -gt 0 ]
do
	case "$1" in
		-y|--yes)            _ASSUME_YES=1 ;;
		-f|--force)          _FORCE=1 ;;
		-n|--dry-run)        _DRY_RUN=1 ;;
		--no-fetch)          _FETCH=0 ;;
		-h|--help)
			sed -n 's/^## \{0,1\}//p' "$0"
			exit 0
			;;
		-*)
			echo "❌ Unknown option: '$1'." >&2
			exit 2
			;;
		*)
			if [ -n "${_REMOTE}" ]
			then
				echo "❌ Unexpected argument: '$1'." >&2
				exit 2
			fi
			_REMOTE="$1"
			;;
	esac
	shift
done

_REMOTE="${_REMOTE:-origin}"

# User is not in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1
then
	echo "❌ '$(basename "${PWD}")' - Not a Git repository." >&2
	exit 1
fi

_TOPLEVEL="$(git rev-parse --show-toplevel)"
_WORKTREE_ROOT="${GIT_WORKTREE_ROOT:-${_TOPLEVEL}/.worktree-branches}"

# Drop stale remote-tracking refs so "[gone]" is accurate. Tolerate a
# missing/unreachable remote: cleanup can still proceed on cached state.
if [ "${_FETCH}" -eq 1 ]
then
	echo "🔄 Pruning stale remote-tracking refs from '${_REMOTE}'..."
	if ! git fetch --prune "${_REMOTE}" >/dev/null 2>&1
	then
		echo "⚠️  Could not fetch from '${_REMOTE}'; using cached refs." >&2
	fi
fi

# Snapshot the branch names the remote has, once up front -- the single
# authoritative source for "is this worktree's remote branch gone?".
# _REMOTE_BRANCHES is a newline-separated list of short branch names and
# _REMOTE_REACHABLE records whether we actually learned the remote's state
# (we must never treat "couldn't find out" as "remote has nothing" and
# delete everything).
#
# With fetching enabled (default) we ask the remote directly over the
# network via `git ls-remote`, the freshest possible answer. With
# --no-fetch we stay fully offline and read the locally cached
# remote-tracking refs (refs/remotes/<remote>/*) that the previous fetch
# left behind -- the prune step above is also skipped in that mode, so
# those cached refs are exactly what the last successful fetch knew.
if [ "${_FETCH}" -eq 1 ]
then
	# Capture git's OWN exit status (an "if cmd" guard), not a pipeline's
	# (whose status would be the trailing sed's), so a failed ls-remote is
	# never mistaken for an empty-but-successful one.
	if _REMOTE_REFS="$(git ls-remote --heads "${_REMOTE}" 2>/dev/null)"
	then
		_REMOTE_REACHABLE=1
		_REMOTE_BRANCHES="$(printf '%s\n' "${_REMOTE_REFS}" \
			| sed -n 's#.*refs/heads/##p')"
	else
		_REMOTE_REACHABLE=0
		_REMOTE_BRANCHES=""
		echo "⚠️  Could not reach '${_REMOTE}'; keeping all worktrees" >&2
		echo "   (can't confirm which remote branches are gone)." >&2
	fi
else
	# Offline: use the cached remote-tracking refs from the last fetch.
	_REMOTE_REACHABLE=1
	_REMOTE_BRANCHES="$(git for-each-ref \
		--format='%(refname:strip=3)' "refs/remotes/${_REMOTE}" \
		| grep -vxF 'HEAD')"
fi

# Decide whether a worktree branch is "gone" (its remote branch no longer
# exists). Echoes "gone" when it should be cleaned up, nothing otherwise.
# Args: <branch-name>.
#
# This asks ONE question of the authoritative source -- does the remote
# still advertise a branch of this name? -- and ignores the branch's
# configured upstream entirely. The upstream is unreliable for this
# workflow: worktree branches made by `git worktree add -b <branch>
# <path> <remote>/<branch>` usually have no upstream at all, and when
# `branch.autoSetupMerge` does set one it can point at the BASE branch
# (e.g. origin/master) rather than a same-named remote branch. In that
# case %(upstream:track) reports ahead/behind against master and never
# "[gone]", so trusting it would wrongly keep a worktree whose own remote
# branch was deleted. The remote branch list has none of that ambiguity.
#
#   * remote reachable, branch present -> keep
#   * remote reachable, branch absent  -> gone
#   * remote unreachable               -> keep (can't confirm deletion;
#                                          never delete on a guess)
branch_is_gone() {
	_BIG_BRANCH="$1"

	# Can't confirm anything if we couldn't reach the remote; keep.
	[ "${_REMOTE_REACHABLE}" -eq 1 ] || return 0

	if printf '%s\n' "${_REMOTE_BRANCHES}" | grep -qxF "${_BIG_BRANCH}"
	then
		return 0        # remote still has it -> keep
	fi
	echo "gone"         # remote reachable, branch absent -> gone
}

# Report, on stdout, why a worktree holds work that must not be silently
# discarded; prints nothing when the worktree is safe to remove. Any
# porcelain output means the tree/index is dirty (modified, staged, or
# untracked files). Args: <worktree-path>.
unsafe_reason() {
	_UR_PATH="$1"

	if [ -d "${_UR_PATH}" ] \
		&& [ -n "$(git -C "${_UR_PATH}" status --porcelain 2>/dev/null)" ]
	then
		echo "uncommitted changes"
	fi
}

# Ask y/N unless --yes was given. Returns 0 (yes) / 1 (no).
confirm() {
	[ "${_ASSUME_YES}" -eq 1 ] && return 0
	printf '%s [y/N] ' "$1" > /dev/tty
	read -r _answer < /dev/tty || _answer=""
	case "${_answer}" in
		[Yy]|[Yy][Ee][Ss]) return 0 ;;
		*) return 1 ;;
	esac
}

echo "🧹 Looking for worktree branches whose upstream is gone..."

_REMOVED=0

# Walk the worktrees. The porcelain output lists each worktree as a
# "worktree <path>" line followed by a "branch refs/heads/<name>" line
# (detached or bare worktrees have no branch line). We pair them up.
_WT_PATH=""
git worktree list --porcelain | while IFS= read -r _line
do
	case "${_line}" in
		"worktree "*)
			_WT_PATH="${_line#worktree }"
			;;
		"branch refs/heads/"*)
			_BRANCH="${_line#branch refs/heads/}"

			# Only touch worktrees under our managed root.
			case "${_WT_PATH}/" in
				"${_WORKTREE_ROOT}"/*) ;;
				*) continue ;;
			esac

			# Is this branch's remote counterpart gone? Decided purely by
			# whether the remote still advertises a branch of this name
			# (the branch's configured upstream is ignored -- see
			# branch_is_gone for why it's unreliable here).
			[ "$(branch_is_gone "${_BRANCH}")" = "gone" ] || continue

			# Protect worktrees with uncommitted changes unless --force
			# was given.
			if [ "${_FORCE}" -ne 1 ]
			then
				_UNSAFE="$(unsafe_reason "${_WT_PATH}")"
				if [ -n "${_UNSAFE}" ]
				then
					echo "🛑 Keeping '${_BRANCH}': ${_UNSAFE} (use --force to remove anyway)."
					continue
				fi
			fi

			if [ "${_DRY_RUN}" -eq 1 ]
			then
				echo "🔎 Would remove worktree '${_WT_PATH}' and branch '${_BRANCH}' (upstream gone)."
				continue
			fi

			if ! confirm "🗑️  Remove worktree '${_WT_PATH}' and delete branch '${_BRANCH}'?"
			then
				echo "⏭️  Keeping '${_BRANCH}'."
				continue
			fi

			# Remove the worktree first, then the branch it held.
			git worktree remove --force "${_WT_PATH}"
			git branch -D "${_BRANCH}"
			echo "✅ Removed '${_BRANCH}'."
			_REMOVED=$((_REMOVED + 1))
			;;
	esac
done

# Tidy any administrative leftovers from removed worktrees.
git worktree prune

echo "✅ Done."
